{
  "name": "@free-real-estate/node-drizzle",
  "description": "Hono and Drizzle backend deployed on Cloudflare Workers",
  "author": "EFrMG",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev --test-scheduled",
    "build": "wrangler deploy --dry-run --outdir dist",
    "start": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "generate": "drizzle-kit generate",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@free-real-estate/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260830.1",
    "@types/node": "^22.19.17",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "wrangler": "^4.146.0"
  }
}
