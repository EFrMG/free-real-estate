# Copy to .env for local development

NODE_ENV=development

# SQLite/libsql connection string
# Locally, a relative file is fine
DB_FILE_NAME=file:local.db

# Secret used to sign session JWTs
# Required when NODE_ENV=production (no dev fallback allowed).
# Generate one with: openssl rand -hex 32
JWT_KEY=

# Password required to self-promote a user to the "agent" role.
# Required when NODE_ENV=production (no dev fallback allowed).
AGENT_PROMOTION_CODE=

# Exact origin of the deployed frontend (no trailing slash), used to lock down CORS for credentialed requests
# Leave unset in local dev to express any request origin
FRONTEND_URL=

# Port to listen on
# Only needed locally if you want something other than 3000
PORT=3000

# Hour of the day at which the database is wiped back to the default demo data. Defaults to 0 (midnight UTC) if unset.
RESET_HOUR_UTC=0

# Disable the daily automatic reset
DISABLE_AUTO_RESET=false
