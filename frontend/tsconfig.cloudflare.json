{
  "extends": "./tsconfig.json",
  "include": ["workers/**/*", "worker-configuration.d.ts"],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true
  }
}
